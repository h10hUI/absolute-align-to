{
  "name": "Absolute-Align-To",
  "version": "1.0.0",
  "description": "Align selected layers to a designated key object across frames.",
  "main": "code.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "esbuild code.ts --bundle --format=iife --target=es2020 --outfile=code.js",
    "build": "npm run typecheck && npm run bundle",
    "watch": "concurrently -n types,bundle -c blue,green \"npm:watch:types\" \"npm:watch:bundle\"",
    "watch:types": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:bundle": "esbuild code.ts --bundle --format=iife --target=es2020 --outfile=code.js --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
